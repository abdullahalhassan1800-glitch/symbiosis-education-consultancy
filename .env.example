# ---------------------------------------------------------------------------
# Local development environment.  DO NOT COMMIT REAL SECRETS.
# (Copy to .env and fill in; .env is git-ignored.)
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; swap for a PostgreSQL URL in production.
DATABASE_URL="file:./dev.db"

# Session / cookie
NODE_ENV="development"
APP_ORIGIN="http://localhost:4173"
SESSION_COOKIE_NAME="sym_admin_sid"
SESSION_TTL_HOURS="12"
# Set to "1" only when serving over HTTPS (production). Enables Secure cookies.
COOKIE_SECURE="0"

# First super-admin bootstrap (used once by `npm run admin:create`).
# Leave blank to be prompted, or set for automated/CI setup.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# Optional email (password reset). If unset, reset links are logged to server stdout.
SMTP_URL=""
MAIL_FROM=""

# Read-only integration key for external sync (e.g. Google Sheets).
# Generate a long random string; send it as the `x-api-key` header.
SHEETS_SYNC_KEY=""

# --- Push new website leads/appointments/enquiries to a Google Sheet ---------
# RECOMMENDED: Google Sheets API v4 with a service account (no public web app).
# Set BOTH of these and the API mode is used automatically.
#   GOOGLE_SHEETS_ID: the id between /d/ and /edit in the sheet URL.
#   GOOGLE_SERVICE_ACCOUNT_JSON: the key file path, OR the raw JSON on one line.
# Share the spreadsheet with the service account's client_email (Editor).
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Alias if you prefer passing a path explicitly:
# GOOGLE_SERVICE_ACCOUNT_FILE="C:\path\to\service-account.json"

# LEGACY: Google Apps Script web-app (/exec) URL. Used only when the API
# settings above are empty. See docs/GOOGLE_SHEETS_SYNC.md.
SHEETS_WEBHOOK_URL=""
